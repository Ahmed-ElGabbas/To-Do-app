# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
HTTP_TIMEOUT_MS=10000

# --- JWT ---
# Required. Minimum 32 chars. Use `openssl rand -base64 48` to generate.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

# --- Database ---
# "postgres" for production, "sqlite" for local/test (uses DB_FILE).
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tasko
DB_PASSWORD=tasko
DB_DATABASE=tasko
DB_FILE=tasko.sqlite
# Never set to true for Postgres; schema changes go through migrations (ADR-0004).
DB_SYNCHRONIZE=false

# --- Redis / Queue / Cache ---
# Leave empty to fall back to in-memory cache and disable the queue.
REDIS_URL=redis://localhost:6379

# --- Mailer ---
# Leave SMTP_HOST empty to use the logging mailer (no emails sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@tasko.dev

# --- Throttling ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- File storage (avatar upload) ---
# "local" writes uploaded files to UPLOAD_DIR (dev/test).
# "s3" stores objects in S3-compatible storage and returns pre-signed URLs.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage
# Maximum avatar size in megabytes.
MAX_FILE_SIZE_MB=5

# --- S3 (only used when STORAGE_DRIVER=s3) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Set for S3-compatible endpoints (MinIO, LocalStack, R2, ...).
S3_ENDPOINT=
# Pre-signed GET URL lifetime in seconds.
S3_PRESIGN_TTL_SECONDS=3600
