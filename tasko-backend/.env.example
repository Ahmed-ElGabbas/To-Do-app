# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
HTTP_TIMEOUT_MS=10000

# --- JWT ---
# WARNING: NEVER run production with the placeholder value below. Anyone who
# reads this file (or the repo) can forge tokens for every user. Generate a
# fresh secret with `openssl rand -base64 48` and inject it via your secret
# manager / CI secrets. The app logs a loud warning at boot if NODE_ENV=production
# while JWT_SECRET is still the placeholder.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

# --- Database ---
# "postgres" for production, "sqlite" for local/test (uses DB_FILE).
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tasko
DB_PASSWORD=tasko
DB_DATABASE=tasko
DB_FILE=tasko.sqlite
# sqlite tiers auto-sync so a fresh checkout just works (ADR-0004). Never set
# to true for Postgres; schema changes go through migrations.
DB_SYNCHRONIZE=true

# --- Redis / Queue / Cache ---
# Leave empty to fall back to in-memory cache and disable the queue.
REDIS_URL=redis://localhost:6379

# --- Mailer ---
# Leave SMTP_HOST empty to use the logging mailer (no emails sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@tasko.dev

# --- Throttling ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- File storage (avatar upload) ---
# "local" writes uploaded files to UPLOAD_DIR (dev/test).
# "s3" stores objects in S3-compatible storage and returns pre-signed URLs.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage
# Maximum avatar size in megabytes.
MAX_FILE_SIZE_MB=5

# --- S3 (only used when STORAGE_DRIVER=s3) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Set for S3-compatible endpoints (MinIO, LocalStack, R2, ...).
S3_ENDPOINT=
# Pre-signed GET URL lifetime in seconds.
S3_PRESIGN_TTL_SECONDS=3600

# --- Firebase (Google social login) ---
# Either FIREBASE_SERVICE_ACCOUNT_PATH (path to the service-account JSON) or
# FIREBASE_SERVICE_ACCOUNT_JSON (the same JSON base64-encoded) plus
# FIREBASE_PROJECT_ID is required for POST /auth/social-login. Leave empty to
# keep the feature disabled (the backend boots fine and rejects social logins).
FIREBASE_PROJECT_ID=tasko-staging
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Firebase App Check (Round 6) ---
# Monitor mode by default: the backend verifies X-Firebase-AppCheck tokens and
# logs pass/reject/missing per request, but never blocks traffic. Flipping this
# to true enables real enforcement — a deliberate, separate decision made after
# reviewing monitor-mode logs, not part of the initial rollout.
APP_CHECK_ENFORCE=false

# --- Realtime (Socket.IO) ---
# The Socket.IO Redis adapter is enabled automatically when REDIS_URL is set
# (see Redis block above); without it the gateway falls back to single-instance
# in-process delivery. The two vars below are the per-user budget for
# client->server socket messages (e.g. the comment "typing" indicator).
REALTIME_EVENT_RATE_LIMIT=60
REALTIME_EVENT_RATE_TTL_MS=30000

# --- Deep linking (Round 4) ---
# Placeholders until a real HTTPS domain exists. The base URL host must match
# the Android intent-filter host and the iOS `applinks:` entitlement, and this
# domain must serve the /.well-known/ files for App Links / Universal Links.
DEEP_LINK_BASE_URL=https://tasko.example
# Apple Team ID used in the apple-app-site-association appID (TEAMID.com.tasko.app).
APPLE_TEAM_ID=TEAM_ID_PLACEHOLDER
# Comma-separated SHA-256 cert fingerprints (colon-separated hex). Defaults to
# the debug keystore; add the release fingerprint when a release keystore exists.
ANDROID_CERT_FINGERPRINTS=47:4E:76:0C:B2:94:C4:24:9A:7A:FC:7A:D5:BE:D6:83:70:98:95:9C:B8:C5:7C:7B:C1:33:B2:13:BE:47:8D:AD
