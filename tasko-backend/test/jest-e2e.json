{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^firebase-admin/app$": "<rootDir>/mocks/firebase-admin-app.stub.ts",
    "^firebase-admin/auth$": "<rootDir>/mocks/firebase-admin-auth.stub.ts",
    "^firebase-admin/messaging$": "<rootDir>/mocks/firebase-admin-messaging.stub.ts"
  }
}
